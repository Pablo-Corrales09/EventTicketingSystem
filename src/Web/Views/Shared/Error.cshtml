@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="alert alert-danger shadow-sm">
                <h1 class="h3 fw-bold mb-1">Ha ocurrido un error</h1>
                <p class="mb-0">No pudimos procesar tu solicitud. Intenta de nuevo en unos minutos.</p>
            </div>

            @if (Model.ShowRequestId)
            {
                <p class="text-muted">
                    <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <hr />

            <h2 class="h5 fw-bold text-dark">Modo de desarrollo</h2>
            <p class="text-muted">
                Cambiar al entorno <strong>Development</strong> mostrará información más detallada sobre el error ocurrido.
            </p>
            <p class="text-muted mb-0">
                <strong>El entorno Development no debe habilitarse en aplicaciones desplegadas.</strong>
                Puede exponer información sensible de las excepciones a los usuarios finales.
                Para depuración local, habilita el entorno <strong>Development</strong> configurando la variable de entorno
                <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong> y reiniciando la aplicación.
            </p>
        </div>
    </div>
</div>

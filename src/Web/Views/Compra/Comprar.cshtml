@model Web.Models.ProcesoPagoViewModel

@{
    ViewData["Title"] = "Confirmar Compra";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0">Resumen de tu Compra</h3>
                </div>
                <div class="card-body p-4">
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <div asp-validation-summary="All" class="text-danger mb-0"></div>
                        </div>
                    }

                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Evento:</strong>
                            <span class="text-secondary">@Model.NombreEvento</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Localidad:</strong>
                            <span class="text-secondary">@Model.NombreLocalidad</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Precio del Boleto:</strong>
                            <span class="fs-5 text-success fw-bold">₡@Model.Precio.ToString("N0")</span>
                        </li>
                    </ul>

                    <form asp-action="ProcesarPago" method="post">
                        <input type="hidden" asp-for="IdEventoLocalidad" />
                        <input type="hidden" asp-for="NombreEvento" />
                        <input type="hidden" asp-for="NombreLocalidad" />
                        <input type="hidden" asp-for="Precio" />
                        <input type="hidden" asp-for="IdUsuario" />

                        <div class="mb-3">
                            <label asp-for="IdMedioPago" class="form-label fw-bold">Selecciona el Medio de Pago</label>
                            <select asp-for="IdMedioPago" class="form-select">
                                <option value="1">Tarjeta de Crédito / Débito</option>
                                <option value="2">SINPE Móvil</option>
                                <option value="3">PayPal</option>
                            </select>
                            <span asp-validation-for="IdMedioPago" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg">Pagar y Generar Factura</button>
                            <a asp-controller="Eventos" asp-action="Index" class="btn btn-outline-secondary">Cancelar y Volver</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
@model IEnumerable<Web.Models.EventoSedeViewModel>

@{
    ViewData["Title"] = ViewBag.Titulo ?? "Eventos Disponibles";
}

<div class="container my-4">
    <div class="page-hero mb-4">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="page-hero-icono"><i class="bi bi-calendar-event"></i></span>
            <div>
                <h1 class="page-hero-titulo">@ViewData["Title"]</h1>
                <p class="page-hero-subtitulo">Explora nuestra cartelera, descubre las sedes y asegura tus entradas.</p>
            </div>
        </div>

        @if (ViewBag.EsAdmin == true)
        {
            <a asp-action="Crear" class="btn btn-success shadow-sm btn-hero-accion">
                <i class="bi bi-plus-circle me-1"></i> Crear Evento
            </a>
        }
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm">
            @ViewBag.Error
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            No hay eventos disponibles en este momento.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
            @foreach (var evento in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 evento-card">
                        <div class="evento-imagen">
                            <svg class="evento-icono" xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4 4.85v.9h1v-.9H4zm7 0v.9h1v-.9h-1zM4 8.3v.9h1v-.9H4zm7 0v.9h1v-.9h-1zm-7 3.45v.9h1v-.9H4zm7 0v.9h1v-.9h-1z"/>
                                <path d="M0 4.5A1.5 1.5 0 0 1 1.5 3h13A1.5 1.5 0 0 1 16 4.5V6a.5.5 0 0 1-.5.5 1.5 1.5 0 0 0 0 3 .5.5 0 0 1 .5.5v1.5A1.5 1.5 0 0 1 14.5 13h-13A1.5 1.5 0 0 1 0 11.5V10a.5.5 0 0 1 .5-.5 1.5 1.5 0 0 0 0-3A.5.5 0 0 1 0 6V4.5zM1.5 4a.5.5 0 0 0-.5.5v1.05a2.5 2.5 0 0 1 0 4.9v1.05a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-1.05a2.5 2.5 0 0 1 0-4.9V4.5a.5.5 0 0 0-.5-.5h-13z"/>
                            </svg>
                            <img src="@(string.IsNullOrWhiteSpace(evento.ImagenUrl) ? "https://picsum.photos/seed/evento-" + evento.IdEvento + "/600/340" : evento.ImagenUrl)"
                                 alt="Imagen del evento @evento.NombreEvento"
                                 loading="lazy"
                                 onerror="this.classList.add('d-none');" />
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark">@evento.NombreEvento</h5>

                            <p class="card-text mb-1 text-secondary">
                                <i class="bi bi-calendar3 me-1"></i><strong>Fecha:</strong> <time datetime="@evento.FechaEvento.ToString("yyyy-MM-dd")">@evento.FechaEvento.ToString("dd/MM/yyyy")</time>
                            </p>

                            <p class="card-text mb-1 text-secondary">
                                <i class="bi bi-clock me-1"></i><strong>Hora:</strong> @evento.HoraEvento.ToString()
                            </p>

                            <p class="card-text mb-3 text-secondary">
                                <i class="bi bi-geo-alt me-1"></i><strong>Sede:</strong> @(evento.Sede?.NombreSedeEvento ?? "Sin sede")
                            </p>

                            <div class="d-flex gap-2">
                                <a asp-controller="Eventos" asp-action="Details" asp-route-id="@evento.IdEvento" class="evento-btn evento-btn-primario mt-auto w-100">
                                    Ver detalles del evento
                                </a>

                                @if (ViewBag.EsAdmin == true)
                                {
                                    <a asp-action="Editar" asp-route-id="@evento.IdEvento"
                                    class="evento-btn evento-btn-rojo shadow-sm"
                                    title="Editar evento"
                                    aria-label="Editar evento">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="modal fade" id="modalDetallesEvento" tabindex="-1" aria-labelledby="modalTitulo" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="modalTitulo">Detalles del evento</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body p-4">
                    <div id="modalCargando">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2 mb-0 text-muted">Consultando disponibilidad...</p>
                        </div>
                    </div>

                    <div id="modalContenido" class="d-none">
                        <div class="row">
                            <div class="col-12 col-md-6 mb-3">
                                <h6 class="fw-bold text-secondary border-bottom pb-2">
                                    <i class="bi bi-info-circle me-1"></i> Información de la Sede
                                </h6>

                                <ul class="list-unstyled mt-3">
                                    <li class="mb-2">
                                        <strong>Ubicación:</strong>
                                        <span id="lblUbicacion" class="text-muted"></span>
                                    </li>
                                    <li>
                                        <strong>Boletos disponibles:</strong>
                                        <span id="lblCapacidad" class="text-muted"></span>
                                    </li>
                                </ul>
                            </div>

                            <div class="col-12 col-md-6 mb-3">
                                <h6 class="fw-bold text-secondary border-bottom pb-2">
                                    <i class="bi bi-tags me-1"></i> Selecciona tu Localidad
                                </h6>

                                <div id="listaLocalidades" class="list-group mt-3"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer d-none bg-light" id="modalFooter">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="button" class="btn btn-success shadow-sm" id="btnContinuarCompra">
                        <i class="bi bi-cart-check me-1"></i> Continuar al Pago
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .cursor-pointer {
        cursor: pointer;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const botonesDetalles = document.querySelectorAll('.btn-ver-detalles');

        botonesDetalles.forEach(boton => {
            boton.addEventListener('click', function () {
                const idEvento = this.getAttribute('data-id');

                const modalCargando = document.getElementById('modalCargando');
                const modalContenido = document.getElementById('modalContenido');
                const modalFooter = document.getElementById('modalFooter');
                const modalTitulo = document.getElementById('modalTitulo');
                const lblUbicacion = document.getElementById('lblUbicacion');
                const lblCapacidad = document.getElementById('lblCapacidad');
                const contenedorLocalidades = document.getElementById('listaLocalidades');

                modalCargando.classList.remove('d-none');
                modalContenido.classList.add('d-none');
                modalFooter.classList.add('d-none');
                modalTitulo.innerText = 'Cargando detalles...';
                contenedorLocalidades.innerHTML = '';

                fetch(`/Eventos/ObtenerDetalles/${idEvento}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Error al cargar los detalles del evento.');
                        }

                        return response.json();
                    })
                    .then(data => {
                        modalTitulo.innerText = data.nombreEvento ?? 'Detalles del evento';

                        lblUbicacion.innerText =
                            data.sede?.ubicacion ?? 'Sin ubicación';

                        const boletosDisponibles = (data.localidades ?? [])
                            .reduce(
                                (suma, loc) => suma + (loc.capacidadDisponible ?? 0),
                                0
                            );

                        lblCapacidad.innerText =
                            boletosDisponibles > 0
                                ? boletosDisponibles
                                : 'No definida';

                        contenedorLocalidades.innerHTML = '';

                        if (data.localidades && data.localidades.length > 0) {
                            data.localidades.forEach(loc => {
                                const nombreLocalidad =
                                    loc.nombreLocalidad &&
                                    loc.nombreLocalidad.trim() !== ''
                                        ? loc.nombreLocalidad
                                        : `Localidad Zona #${loc.idLocalidad}`;

                                const precio = new Intl.NumberFormat('es-CR', {
                                    style: 'currency',
                                    currency: 'CRC',
                                    minimumFractionDigits: 0
                                }).format(loc.precio ?? 0);

                                const label = document.createElement('label');
                                label.className =
                                    'list-group-item d-flex justify-content-between align-items-center list-group-item-action cursor-pointer';

                                const div = document.createElement('div');

                                const input = document.createElement('input');
                                input.className = 'form-check-input me-2';
                                input.type = 'radio';
                                input.name = 'radioLocalidad';
                                input.value = loc.idEventoLocalidad;

                                const nombre = document.createTextNode(nombreLocalidad);

                                div.appendChild(input);
                                div.appendChild(nombre);

                                const badge = document.createElement('span');
                                badge.className = 'badge bg-primary rounded-pill';
                                badge.innerText = precio;

                                label.appendChild(div);
                                label.appendChild(badge);

                                contenedorLocalidades.appendChild(label);
                            });
                        } else {
                            const mensaje = document.createElement('p');
                            mensaje.className = 'text-danger small';
                            mensaje.innerText =
                                'No hay localidades disponibles para este evento.';

                            contenedorLocalidades.appendChild(mensaje);
                        }

                        modalCargando.classList.add('d-none');
                        modalContenido.classList.remove('d-none');

                        if (data.localidades && data.localidades.length > 0) {
                            modalFooter.classList.remove('d-none');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);

                        modalCargando.classList.add('d-none');
                        modalFooter.classList.add('d-none');

                        modalTitulo.innerText = 'Error de conexión';

                        modalContenido.innerHTML = `
                            <div class="alert alert-danger mb-0">
                                No se pudo cargar la información del evento en este momento.
                            </div>
                        `;

                        modalContenido.classList.remove('d-none');
                    });
            });
        });

        document.getElementById('btnContinuarCompra').addEventListener('click', function () {
            const localidadSeleccionada =
                document.querySelector('input[name="radioLocalidad"]:checked');

            if (!localidadSeleccionada) {
                alert('Por favor, selecciona una localidad de la lista para continuar.');
                return;
            }

            const idEventoLocalidad = localidadSeleccionada.value;

            window.location.href =
                `/Compra/Comprar?idEventoLocalidad=${encodeURIComponent(idEventoLocalidad)}`;
        });
    });
</script>

<style>
.evento-btn {
    border-radius: var(--radius-pill);
    padding: 0.6rem 1.25rem;
    font-weight: 600;
    transition: all 0.2s ease-in-out;
    box-shadow: 0 0.25rem 0.5rem var(--accent-soft-15);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
}

.evento-btn-primario {
    background-color: #ffffff;
    border: 1px solid var(--bs-primary, #0d6efd);
    color: var(--bs-primary, #0d6efd);
}

.evento-btn-primario:hover {
    background-color: var(--bs-primary, #0d6efd);
    color: #ffffff;
    border-color: var(--bs-primary, #0d6efd);
}

.evento-btn-rojo {
    background-color: #ffffff;
    border: 1px solid #dc3545;
    color: #dc3545;
}

.evento-btn-rojo:hover {
    background-color: #dc3545;
    color: #ffffff;
    border-color: #dc3545;
}
</style>
@model List<Web.Models.EventoViewModel>

@{
    ViewData["Title"] = "Eventos";
}

<div class="container mt-4">
    <div class="mb-4">
        <h1>Eventos disponibles</h1>
        <p class="text-muted">
            Consulta la información de los eventos registrados en el sistema.
        </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }
    else if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No hay eventos disponibles.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Evento</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Sede</th>
                        <th>Ubicación</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var evento in Model)
                    {
                        <tr>
                            <td>@evento.NombreEvento</td>
                            <td>@evento.FechaEvento.ToString("dd/MM/yyyy")</td>
                            <td>@evento.HoraEvento.ToString("HH:mm")</td>
                            <td>
                                @(evento.Sede?.NombreSedeEvento ?? "Sin sede")
                            </td>
                            <td>
                                @(evento.Sede?.Ubicacion ?? "No disponible")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
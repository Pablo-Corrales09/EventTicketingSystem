@model Web.Models.EventoCreacionViewModel

@{
    ViewData["Title"] = "Editar Evento";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-6">
            <h1 class="fw-bold text-dark mb-1">Editar Evento</h1>
            <p class="text-muted mb-4">Actualiza la información del evento.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger shadow-sm"></div>
            }

            <form asp-action="Editar" asp-route-id="@Model.IdEvento" method="post" enctype="multipart/form-data" class="card admin-form card-body shadow-sm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdEvento" />

                <div class="mb-3">
                    <label asp-for="NombreEvento" class="form-label fw-semibold"></label>
                    <input asp-for="NombreEvento" class="form-control" placeholder="Nombre del evento" />
                    <span asp-validation-for="NombreEvento" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="mb-3">
                            <label asp-for="FechaEvento" class="form-label fw-semibold"></label>
                            <input asp-for="FechaEvento" type="date" class="form-control" />
                            <span asp-validation-for="FechaEvento" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="mb-3">
                            <label asp-for="HoraEvento" class="form-label fw-semibold"></label>
                            <input asp-for="HoraEvento" type="time" class="form-control" />
                            <span asp-validation-for="HoraEvento" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="IdSede" class="form-label fw-semibold"></label>
                    <select asp-for="IdSede" class="form-select">
                        <option value="">-- Selecciona una sede --</option>
                        @foreach (var sede in Model.Sedes)
                        {
                            <option value="@sede.IdSedeEvento">@sede.NombreSedeEvento — @sede.Ubicacion</option>
                        }
                    </select>
                    <span asp-validation-for="IdSede" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImagenEvento" class="form-label fw-semibold"></label>
                    <input asp-for="ImagenEvento" type="file" class="form-control" accept="image/*" />
                    <div class="form-text">Déjalo vacío para conservar la imagen actual.</div>

                    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                    {
                        <div class="mt-2">
                            <img src="@Model.ImagenUrl" alt="Imagen actual del evento" class="img-thumbnail admin-form-preview" style="max-height: 120px;" />
                        </div>
                    }
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill py-2">Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary py-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model List<Web.Models.FacturaViewModel>

@{
    ViewData["Title"] = ViewBag.EsAdmin == true ? "Gestión de Facturas" : "Mis Facturas";
    var esAdmin = ViewBag.EsAdmin == true;
}

<div class="container mt-4">
    <div class="mb-4">
        <h1 class="fw-bold text-dark mb-0">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">
            @(esAdmin ? "Consulta las facturas y los boletos relacionados." : "Consulta el historial de tus compras.")
        </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm">@ViewBag.Error</div>
    }

    @if (ViewBag.Aviso != null)
    {
        <div class="alert alert-info shadow-sm">@ViewBag.Aviso</div>
    }

    @if (esAdmin)
    {
        <form method="get" class="card card-body shadow-sm mb-4">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label fw-semibold small mb-1">Número de factura</label>
                    <input type="text" name="numeroFactura" value="@Context.Request.Query["numeroFactura"]"
                           class="form-control" placeholder="FAC-..." />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label fw-semibold small mb-1">Desde</label>
                    <input type="date" name="fechaDesde" value="@Context.Request.Query["fechaDesde"]"
                           class="form-control" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label fw-semibold small mb-1">Hasta</label>
                    <input type="date" name="fechaHasta" value="@Context.Request.Query["fechaHasta"]"
                           class="form-control" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label fw-semibold small mb-1">Evento</label>
                    <input type="text" name="nombreEvento" value="@Context.Request.Query["nombreEvento"]"
                           class="form-control" placeholder="Nombre del evento" />
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill py-2">Buscar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary py-2">Limpiar</a>
                </div>
            </div>
        </form>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info shadow-sm">
            No hay facturas registradas.
        </div>
    }
    else
    {
        @foreach (var factura in Model)
        {
            <div class="card factura-card shadow-sm mb-4 border-0">
                <div class="card-header bg-dark text-white">
                    <div class="row">
                        <div class="col-12 col-sm-4">
                            <strong>Factura:</strong> @factura.NumeroFactura
                        </div>
                        <div class="col-12 col-sm-4">
                            <strong>Fecha:</strong> <time datetime="@factura.FechaFactura.ToString("yyyy-MM-dd")">@factura.FechaFactura.ToString("dd/MM/yyyy")</time>
                        </div>
                        <div class="col-12 col-sm-4">
                            <strong>Total:</strong> ₡@factura.Total.ToString("N2")
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    @if (esAdmin)
                    {
                        var primerBoleto = factura.Boletos.FirstOrDefault();
                        <p class="mb-3">
                            <strong>Cliente:</strong>
                            @if (primerBoleto != null)
                            {
                                <span>@primerBoleto.NombreUsuario @primerBoleto.ApellidoUsuario (@primerBoleto.CorreoUsuario)</span>
                            }
                            else
                            {
                                <span>ID de usuario: @factura.IdUsuario</span>
                            }
                        </p>
                    }

                    @if (factura.Boletos.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            Esta factura no tiene boletos relacionados.
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var boleto in factura.Boletos)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                        <div>
                                            <a asp-controller="Boletos" asp-action="Details" asp-route-id="@boleto.IdBoleto" class="fw-semibold link-enlace">
                                                @boleto.NumBoleto
                                            </a>
                                            <div class="text-muted small">
                                                @boleto.NombreEvento · @boleto.NombreLocalidad
                                            </div>
                                            <div class="text-muted small">
                                                @if (boleto.FechaEvento.HasValue)
                                                {
                                                    <time datetime="@boleto.FechaEvento.Value.ToString("yyyy-MM-dd")">@boleto.FechaEvento.Value.ToString("dd/MM/yyyy")</time>
                                                }
                                                else
                                                {
                                                    <text>Fecha no disponible</text>
                                                }
                                                @if (boleto.HoraEvento.HasValue)
                                                {
                                                    <text> · @boleto.HoraEvento.Value.ToString("HH:mm")</text>
                                                }
                                            </div>
                                        </div>
                                        <span class="fw-bold text-success">₡@boleto.Precio.ToString("N2")</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .factura-card {
        border-radius: var(--radius-md);
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .factura-card:hover {
        transform: translateY(var(--lift-card));
        box-shadow: 0 1rem 2rem rgba(13, 110, 253, 0.12) !important;
    }

    @@media (prefers-reduced-motion: reduce) {
        .factura-card:hover {
            transform: none;
        }

        .factura-card {
            transition: none;
        }
    }
</style>

@model List<Web.Models.FacturaViewModel>

@{
    ViewData["Title"] = ViewBag.EsAdmin == true ? "Gestión de Facturas" : "Mis Facturas";
    var esAdmin = ViewBag.EsAdmin == true;
}

<div class="container mt-4">
    <div class="mb-4">
        <h1 class="fw-bold text-dark mb-0">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">
            @(esAdmin ? "Consulta las facturas y los boletos relacionados." : "Consulta el historial de tus compras.")
        </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm">@ViewBag.Error</div>
    }

    @if (ViewBag.Aviso != null)
    {
        <div class="alert alert-info shadow-sm">@ViewBag.Aviso</div>
    }

    @if (esAdmin)
    {
        <form method="get" class="card card-body shadow-sm mb-4">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold small mb-1">Número de factura</label>
                    <input type="text" name="numeroFactura" value="@Context.Request.Query["numeroFactura"]"
                           class="form-control" placeholder="FAC-..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small mb-1">Desde</label>
                    <input type="date" name="fechaDesde" value="@Context.Request.Query["fechaDesde"]"
                           class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small mb-1">Hasta</label>
                    <input type="date" name="fechaHasta" value="@Context.Request.Query["fechaHasta"]"
                           class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small mb-1">Evento</label>
                    <input type="text" name="nombreEvento" value="@Context.Request.Query["nombreEvento"]"
                           class="form-control" placeholder="Nombre del evento" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">Buscar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </div>
        </form>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info shadow-sm">
            No hay facturas registradas.
        </div>
    }
    else
    {
        @foreach (var factura in Model)
        {
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-dark text-white">
                    <div class="row">
                        <div class="col-md-4">
                            <strong>Factura:</strong> @factura.NumeroFactura
                        </div>
                        <div class="col-md-4">
                            <strong>Fecha:</strong> @factura.FechaFactura.ToString("dd/MM/yyyy")
                        </div>
                        <div class="col-md-4">
                            <strong>Total:</strong> ₡@factura.Total.ToString("N2")
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    @if (esAdmin)
                    {
                        var primerBoleto = factura.Boletos.FirstOrDefault();
                        <p class="mb-3">
                            <strong>Cliente:</strong>
                            @if (primerBoleto != null)
                            {
                                <span>@primerBoleto.NombreUsuario @primerBoleto.ApellidoUsuario (@primerBoleto.CorreoUsuario)</span>
                            }
                            else
                            {
                                <span>ID de usuario: @factura.IdUsuario</span>
                            }
                        </p>
                    }

                    @if (factura.Boletos.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            Esta factura no tiene boletos relacionados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Boleto</th>
                                        <th>Evento</th>
                                        <th>Localidad</th>
                                        <th>Fecha</th>
                                        <th>Hora</th>
                                        <th class="text-end">Precio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var boleto in factura.Boletos)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="Boletos" asp-action="Details" asp-route-id="@boleto.IdBoleto">
                                                    @boleto.NumBoleto
                                                </a>
                                            </td>
                                            <td>@boleto.NombreEvento</td>
                                            <td>@boleto.NombreLocalidad</td>
                                            <td>@(boleto.FechaEvento?.ToString("dd/MM/yyyy") ?? "No disponible")</td>
                                            <td>@(boleto.HoraEvento?.ToString("HH:mm") ?? "No disponible")</td>
                                            <td class="text-end">₡@boleto.Precio.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

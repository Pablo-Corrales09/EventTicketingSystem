@model List<Web.Models.FacturaViewModel>

@{
    ViewData["Title"] = "Facturas";
}

<div class="container mt-4">
    <div class="mb-4">
        <h1>Facturas registradas</h1>
        <p class="text-muted">
            Consulta las facturas y los boletos relacionados.
        </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }
    else if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No hay facturas registradas.
        </div>
    }
    else
    {
        @foreach (var factura in Model)
        {
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <div class="row">
                        <div class="col-md-4">
                            <strong>Factura:</strong> @factura.NumeroFactura
                        </div>

                        <div class="col-md-4">
                            <strong>Fecha:</strong>
                            @factura.FechaFactura.ToString("dd/MM/yyyy")
                        </div>

                        <div class="col-md-4">
                            <strong>Total:</strong>
                            ₡@factura.Total.ToString("N2")
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <p>
                        <strong>Usuario:</strong> @factura.IdUsuario
                        |
                        <strong>Medio de pago:</strong> @factura.IdMedioPago
                    </p>

                    @if (factura.Boletos.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            Esta factura no tiene boletos relacionados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered align-middle">
                                <thead>
                                    <tr>
                                        <th>Boleto</th>
                                        <th>Cliente</th>
                                        <th>Evento</th>
                                        <th>Localidad</th>
                                        <th>Fecha</th>
                                        <th>Hora</th>
                                        <th>Precio</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var boleto in factura.Boletos)
                                    {
                                        <tr>
                                            <td>@boleto.NumBoleto</td>

                                            <td>
                                                @boleto.NombreUsuario
                                                @boleto.ApellidoUsuario
                                            </td>

                                            <td>@boleto.NombreEvento</td>

                                            <td>@boleto.NombreLocalidad</td>

                                            <td>
                                                @(boleto.FechaEvento?.ToString("dd/MM/yyyy")
                                                    ?? "No disponible")
                                            </td>

                                            <td>
                                                @(boleto.HoraEvento?.ToString("HH:mm")
                                                    ?? "No disponible")
                                            </td>

                                            <td>
                                                ₡@boleto.Precio.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
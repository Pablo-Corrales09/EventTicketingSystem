@model Web.Models.BoletoViewModel

@{
    ViewData["Title"] = "Tu Boleto";
}

@{
    string imagenQr = string.Empty;
    var payload = $"BOLETO|{Model.IdBoleto}|{Model.NumBoleto}|{Model.NombreEvento}";
    using (var generador = new QRCodeGenerator())
    {
        var datos = generador.CreateQrCode(payload, QRCodeGenerator.ECCLevel.Q);
        var qr = new Base64QRCode(datos);
        imagenQr = qr.GetGraphic(20);
    }
}

<div class="container mt-4 d-flex justify-content-center">
    <div class="card ticket shadow-lg border-0 w-100" style="max-width: 520px;">
        <div class="card-header bg-primary text-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="bi bi-ticket-perforated me-2"></i>Entrada Digital</h4>
                <span class="badge bg-light text-primary">VÁLIDO</span>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="text-center mb-3">
                <h3 class="fw-bold text-dark mb-0">@Model.NombreEvento</h3>
            </div>

            <div class="text-center mb-4">
                <img src="data:image/png;base64,@imagenQr" alt="Código QR del boleto"
                     class="img-fluid border rounded p-2 bg-white" style="max-width: 200px;" />
                <p class="text-muted small mt-2 mb-0">Presenta este código QR en el acceso al evento.</p>
            </div>

            <hr />

            <div class="row">
                <div class="col-6 mb-3">
                    <small class="text-muted d-block">Número de Boleto</small>
                    <strong class="text-dark">@Model.NumBoleto</strong>
                </div>

                <div class="col-6 mb-3">
                    <small class="text-muted d-block">Localidad</small>
                    <strong class="text-dark">@Model.NombreLocalidad</strong>
                </div>

                <div class="col-6 mb-3">
                    <small class="text-muted d-block">Fecha del Evento</small>
                    <strong class="text-dark">
                        @(Model.FechaEvento?.ToString("dd/MM/yyyy") ?? "No disponible")
                    </strong>
                </div>

                <div class="col-6 mb-3">
                    <small class="text-muted d-block">Hora del Evento</small>
                    <strong class="text-dark">@(Model.HoraEvento?.ToString("HH:mm") ?? "No disponible")</strong>
                </div>

                <div class="col-6 mb-3">
                    <small class="text-muted d-block">Comprador</small>
                    <strong class="text-dark">@Model.NombreUsuario @Model.ApellidoUsuario</strong>
                </div>

                <div class="col-6 mb-3">
                    <small class="text-muted d-block">Precio Pagado</small>
                    <strong class="text-dark">₡@Model.Precio.ToString("N2")</strong>
                </div>

                <div class="col-6 mb-3">
                    <small class="text-muted d-block">Número de Factura</small>
                    <strong class="text-dark">@Model.NumeroFactura</strong>
                </div>

                <div class="col-6 mb-3">
                    <small class="text-muted d-block">Fecha de Compra</small>
                    <strong class="text-dark">
                        @(Model.FechaCompra?.ToString("dd/MM/yyyy") ?? "No disponible")
                    </strong>
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                    <i class="bi bi-arrow-left me-1"></i> Mis Boletos
                </a>
                <button type="button" class="btn btn-primary flex-fill" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Imprimir
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .ticket {
        border-radius: 16px;
        overflow: hidden;
    }
    .ticket .card-body {
        background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
    }
    @@media print {
        .navbar, .footer, .btn { display: none !important; }
    }
</style>

@model IEnumerable<Web.Models.BoletoViewModel>

@{
    ViewData["Title"] = ViewBag.EsAdmin == true ? "Información de los boletos" : "Mis Boletos";
    var esAdmin = ViewBag.EsAdmin == true;
}

<div class="container mt-4">
    <div class="page-hero mb-4">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="page-hero-icono"><i class="bi bi-ticket-perforated"></i></span>
            <div>
                <h1 class="page-hero-titulo">@ViewData["Title"]</h1>
                <p class="page-hero-subtitulo">
                    @(esAdmin ? "Consulta y filtra todos los boletos vendidos." : "Estos son los boletos que has comprado.")
                </p>
            </div>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm">@ViewBag.Error</div>
    }

    @if (ViewBag.Aviso != null)
    {
        <div class="alert alert-info shadow-sm">@ViewBag.Aviso</div>
    }

    <form method="get" class="card card-body shadow-sm mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold small mb-1">Número de boleto</label>
                <input type="text" name="numeroBoleto" value="@Context.Request.Query["numeroBoleto"]"
                       class="form-control" placeholder="BOL-..." />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold small mb-1">Evento</label>
                <input type="text" name="nombreEvento" value="@Context.Request.Query["nombreEvento"]"
                       class="form-control" placeholder="Nombre del evento" />
            </div>
            @if (esAdmin)
            {
                <div class="col-12 col-md-3">
                    <label class="form-label fw-semibold small mb-1">Cliente</label>
                    <input type="text" name="nombreCliente" value="@Context.Request.Query["nombreCliente"]"
                           class="form-control" placeholder="Nombre del cliente" />
                </div>
            }
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill py-2">Buscar</button>
                <a asp-action="Index" class="btn btn-outline-secondary py-2">Limpiar</a>
            </div>
        </div>
    </form>

    @if (esAdmin)
    {
        var reporte = ViewBag.Reporte as BoletosReporteViewModel;

        if (reporte != null)
        {
            var periodo = ViewBag.RangoReporte as string ?? DateTime.Now.ToString("MMMM yyyy");

            <section class="mb-4">
                <h2 class="h5 fw-bold text-dark mb-3">
                    <i class="bi bi-bar-chart-line me-2 text-primary"></i>Reporte de ventas de boletos
                </h2>

                <form method="get" class="card card-body shadow-sm mb-4">
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold small mb-1">Desde (mes)</label>
                            <input type="month" name="reporteDesde" value="@ViewBag.ReporteDesde"
                                   class="form-control" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold small mb-1">Hasta (mes)</label>
                            <input type="month" name="reporteHasta" value="@ViewBag.ReporteHasta"
                                   class="form-control" />
                        </div>
                        <div class="col-12 col-md-3 d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-fill py-2">Aplicar rango</button>
                            <a asp-action="Index" class="btn btn-outline-secondary py-2">Limpiar</a>
                        </div>
                        <div class="col-12 col-md-3 d-flex justify-content-md-end">
                            <a asp-action="ExportarExcel"
                               asp-route-numeroBoleto="@Context.Request.Query["numeroBoleto"]"
                               asp-route-nombreEvento="@Context.Request.Query["nombreEvento"]"
                               asp-route-nombreCliente="@Context.Request.Query["nombreCliente"]"
                               asp-route-reporteDesde="@ViewBag.ReporteDesde"
                               asp-route-reporteHasta="@ViewBag.ReporteHasta"
                               class="btn btn-success py-2">
                                <i class="bi bi-file-earmark-excel me-1"></i>Exportar a Excel
                            </a>
                        </div>
                    </div>
                </form>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-4">
                        <div class="card h-100 shadow-sm border-0 reporte-tarjeta">
                            <div class="card-body">
                                <p class="small text-muted fw-semibold mb-1">Total facturado · @periodo</p>
                                <p class="display-6 fw-bold text-primary mb-0">₡@reporte.TotalMes.ToString("N2")</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="card h-100 shadow-sm border-0 reporte-tarjeta">
                            <div class="card-body">
                                <p class="small text-muted fw-semibold mb-1">Boletos vendidos · @periodo</p>
                                <p class="display-6 fw-bold mb-0">@reporte.BoletosMes</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="card h-100 shadow-sm border-0 reporte-tarjeta">
                            <div class="card-body">
                                <p class="small text-muted fw-semibold mb-1">Eventos con ventas · @periodo</p>
                                <p class="display-6 fw-bold mb-0">@reporte.EventosMes</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white">
                        <h3 class="h6 fw-bold text-dark mb-0">
                            <i class="bi bi-ticket-perforated me-2 text-primary"></i>Boletos vendidos por evento
                        </h3>
                    </div>
                    <div class="card-body p-0">
                        @if (reporte.Eventos.Count == 0)
                        {
                            <p class="text-muted text-center py-4 mb-0">No hay boletos vendidos con los criterios indicados.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col">Evento</th>
                                            <th scope="col" class="text-center">Boletos</th>
                                            <th scope="col" class="text-end">Total facturado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var evento in reporte.Eventos)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@evento.NombreEvento</td>
                                                <td class="text-center">@evento.CantidadBoletos</td>
                                                <td class="text-end fw-semibold text-success">₡@evento.TotalFacturado.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            No hay boletos que coincidan con la búsqueda.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card boleto-card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-dark mb-0">@item.NumBoleto</h5>
                                <span class="badge boleto-precio rounded-pill">₡@item.Precio.ToString("N2")</span>
                            </div>
                            <p class="card-text text-secondary mb-1">@item.NombreEvento</p>
                            <p class="card-text text-muted small mb-2">@item.NombreLocalidad</p>
                            @if (esAdmin)
                            {
                                <p class="card-text text-muted small mb-3">Cliente: @item.NombreUsuario @item.ApellidoUsuario</p>
                            }
                            <a asp-action="Details" asp-route-id="@item.IdBoleto" class="btn btn-outline-primary boleto-btn mt-auto">
                                Ver boleto
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .boleto-card {
        border-radius: var(--radius-md);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .reporte-tarjeta {
        border-radius: var(--radius-md);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .reporte-tarjeta:hover {
        transform: translateY(var(--lift-card));
        box-shadow: 0 1rem 2rem rgba(13, 110, 253, 0.12) !important;
    }

    .boleto-card:hover {
        transform: translateY(var(--lift-card));
        box-shadow: 0 1rem 2rem rgba(13, 110, 253, 0.12) !important;
    }

    .boleto-precio {
        background: var(--accent-soft-10);
        color: var(--accent);
        font-weight: 600;
    }

    .boleto-btn {
        border-radius: var(--radius-pill);
        font-weight: 600;
        padding: 0.6rem 1.25rem;
    }

    @@media (prefers-reduced-motion: reduce) {
        .boleto-card:hover,
        .reporte-tarjeta:hover {
            transform: none;
        }

        .boleto-card,
        .reporte-tarjeta {
            transition: none;
        }
    }
</style>

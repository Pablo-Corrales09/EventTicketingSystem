@model IEnumerable<Web.Models.BoletoViewModel>

@{
    ViewData["Title"] = "Listado de Boletos";
}

<h2>@ViewData["Title"]</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Número</th>
            <th>Evento</th>
            <th>Precio</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdBoleto</td>
                <td>@item.NumBoleto</td>
                <td>@item.NombreEvento</td>
                <td>@item.Precio</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdBoleto" class="btn btn-info btn-sm">Detalles</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@model IEnumerable<Web.Models.EventoViewModel>

@{
    ViewData["Title"] = "Inicio";
    var esCR = System.Globalization.CultureInfo.GetCultureInfo("es-CR");
}

<div class="container py-5">

    @if (Model != null && Model.Any())
    {
        var ordenHero = (ViewBag.OrdenHero as List<int>) ?? new List<int>();
        var eventosDestacados = ordenHero
            .Select(id => Model.FirstOrDefault(e => e.IdEvento == id))
            .OfType<EventoViewModel>()
            .ToList();

        if (eventosDestacados.Count == 0)
        {
            eventosDestacados = Model.Take(5).ToList();
        }

        var primerIndice = 0;

        <div id="heroCarrusel" class="carousel slide hero-section rounded-4 mb-5 shadow-sm" data-bs-ride="carousel" data-bs-interval="5000">
            <div class="carousel-inner">
                @for (var i = 0; i < eventosDestacados.Count; i++)
                {
                    var evento = eventosDestacados[i];

                    <div class="carousel-item @(i == primerIndice ? "active" : "")">
                        <img src="@(string.IsNullOrWhiteSpace(evento.ImagenUrl) ? "https://picsum.photos/seed/hero-" + evento.IdEvento + "/1600/640" : evento.ImagenUrl)"
                             class="d-block w-100 hero-imagen"
                             alt="Imagen del evento @evento.NombreEvento"
                             loading="@(i == primerIndice ? "eager" : "lazy")"
                             onerror="this.classList.add('d-none');" />

                        <div class="hero-overlay"></div>

                        <div class="carousel-caption d-flex flex-column align-items-center justify-content-center h-100">
                            @if (i == primerIndice)
                            {
                                <span class="badge rounded-pill px-3 py-2 fw-semibold mb-3 hero-badge">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                                        <path d="M4 4.85v.9h1v-.9H4zm7 0v.9h1v-.9h-1zM4 8.3v.9h1v-.9H4zm7 0v.9h1v-.9h-1zm-7 3.45v.9h1v-.9H4zm7 0v.9h1v-.9h-1z"/>
                                        <path d="M0 4.5A1.5 1.5 0 0 1 1.5 3h13A1.5 1.5 0 0 1 16 4.5V6a.5.5 0 0 1-.5.5 1.5 1.5 0 0 0 0 3 .5.5 0 0 1 .5.5v1.5A1.5 1.5 0 0 1 14.5 13h-13A1.5 1.5 0 0 1 0 11.5V10a.5.5 0 0 1 .5-.5 1.5 1.5 0 0 0 0-3A.5.5 0 0 1 0 6V4.5zM1.5 4a.5.5 0 0 0-.5.5v1.05a2.5 2.5 0 0 1 0 4.9v1.05a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-1.05a2.5 2.5 0 0 1 0-4.9V4.5a.5.5 0 0 0-.5-.5h-13z"/>
                                    </svg>
                                    Tu boleteria de confianza
                                </span>
                                <h1 class="display-5 fw-bold mb-3">Proximos eventos</h1>
                                <p class="lead mb-4 mx-auto hero-subtitulo">
                                    Encuentra los mejores conciertos, partidos y espectaculos, y asegura tus entradas en segundos.
                                </p>
                            }
                            else
                            {
                                <h2 class="display-6 fw-bold mb-2">@evento.NombreEvento</h2>
                                <p class="mb-4 hero-subtitulo">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                                        <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857V3.857z"/>
                                        <path d="M6.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                                    </svg>
                                    @evento.FechaEvento.ToString("dd 'de' MMMM 'de' yyyy", esCR)
                                </p>
                            }

                            <a asp-controller="Eventos" asp-action="Details" asp-route-id="@evento.IdEvento" class="btn evento-btn">
                                Ver evento
                            </a>
                        </div>
                    </div>
                }
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarrusel" data-bs-slide="prev" aria-label="Anterior">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarrusel" data-bs-slide="next" aria-label="Siguiente">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>

            <div class="carousel-indicators">
                @for (var i = 0; i < eventosDestacados.Count; i++)
                {
                    <button type="button"
                            data-bs-target="#heroCarrusel"
                            data-bs-slide-to="@i"
                            class="@(i == primerIndice ? "active" : "")"
                            aria-current="@(i == primerIndice ? "true" : null)"
                            aria-label="Diapositiva @(i + 1)"></button>
                }
            </div>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm">
            @ViewBag.Error
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            No hay eventos disponibles en este momento.
        </div>
    }
    else
    {
        var sedesUnicas = Model
            .Select(e => e.Sede?.NombreSedeEvento)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct()
            .OrderBy(s => s)
            .ToList();

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-5">
                        <label for="filtroNombre" class="form-label small text-secondary fw-semibold mb-1">
                            <i class="bi bi-search me-1"></i>Nombre del evento
                        </label>
                        <input type="text" id="filtroNombre" class="form-control" placeholder="Buscar por nombre..." autocomplete="off" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label for="filtroSede" class="form-label small text-secondary fw-semibold mb-1">
                            <i class="bi bi-geo-alt me-1"></i>Locación
                        </label>
                        <select id="filtroSede" class="form-select">
                            <option value="">Todas las locaciones</option>
                            @foreach (var sede in sedesUnicas)
                            {
                                <option value="@sede">@sede</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <label for="filtroFecha" class="form-label small text-secondary fw-semibold mb-1">
                            <i class="bi bi-calendar3 me-1"></i>Fecha
                        </label>
                        <input type="date" id="filtroFecha" class="form-control" />
                    </div>

                    <div class="col-12 col-md-1 d-grid">
                        <button type="button" id="btnLimpiarFiltros" class="btn btn-outline-secondary" title="Limpiar filtros" aria-label="Limpiar filtros">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="contenedorEventos">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
            @{
                var indice = 0;
            }
            @foreach (var evento in Model)
            {
                indice++;
                var retraso = ((indice % 6) * 0.08).ToString(System.Globalization.CultureInfo.InvariantCulture) + "s";

                <div class="col" style="animation-delay: @retraso;">
                    <article class="card evento-card h-100 border-0 shadow-sm"
                             data-nombre="@evento.NombreEvento.ToLowerInvariant()"
                             data-fecha="@evento.FechaEvento.ToString("yyyy-MM-dd")"
                             data-sede="@((evento.Sede?.NombreSedeEvento ?? "").ToLowerInvariant())">
                        <div class="evento-imagen">
                            <svg class="evento-icono" xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4 4.85v.9h1v-.9H4zm7 0v.9h1v-.9h-1zM4 8.3v.9h1v-.9H4zm7 0v.9h1v-.9h-1zm-7 3.45v.9h1v-.9H4zm7 0v.9h1v-.9h-1z"/>
                                <path d="M0 4.5A1.5 1.5 0 0 1 1.5 3h13A1.5 1.5 0 0 1 16 4.5V6a.5.5 0 0 1-.5.5 1.5 1.5 0 0 0 0 3 .5.5 0 0 1 .5.5v1.5A1.5 1.5 0 0 1 14.5 13h-13A1.5 1.5 0 0 1 0 11.5V10a.5.5 0 0 1 .5-.5 1.5 1.5 0 0 0 0-3A.5.5 0 0 1 0 6V4.5zM1.5 4a.5.5 0 0 0-.5.5v1.05a2.5 2.5 0 0 1 0 4.9v1.05a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-1.05a2.5 2.5 0 0 1 0-4.9V4.5a.5.5 0 0 0-.5-.5h-13z"/>
                            </svg>
                            <img src="@(string.IsNullOrWhiteSpace(evento.ImagenUrl) ? "https://picsum.photos/seed/evento-" + evento.IdEvento + "/600/340" : evento.ImagenUrl)"
                                 alt="Imagen del evento @evento.NombreEvento"
                                 loading="lazy"
                                 onerror="this.classList.add('d-none');" />
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold text-dark mb-3">@evento.NombreEvento</h5>

                            <div class="d-flex align-items-center text-secondary mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-2 flex-shrink-0" viewBox="0 0 16 16">
                                    <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857V3.857z"/>
                                    <path d="M6.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                                </svg>
                                <time datetime="@evento.FechaEvento.ToString("yyyy-MM-dd")">@evento.FechaEvento.ToString("dd 'de' MMMM 'de' yyyy", esCR)</time>
                            </div>

                            <div class="d-flex align-items-center text-secondary mb-4">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-2 flex-shrink-0" viewBox="0 0 16 16">
                                    <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                                </svg>
                                <span>@evento.HoraEvento.ToString("HH:mm") hrs</span>
                            </div>

                            <a asp-controller="Eventos" asp-action="Details" asp-route-id="@evento.IdEvento" class="btn evento-btn mt-auto">
                                Comprar entradas
                            </a>
                        </div>
                    </article>
                </div>
            }
            </div>

            <div id="sinResultados" class="d-none text-center text-muted py-5">
                <i class="bi bi-search fs-1 d-block mb-2"></i>
                <p class="fs-5 mb-0">No se encontraron eventos con los criterios indicados.</p>
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const filtroNombre = document.getElementById('filtroNombre');
        const filtroSede = document.getElementById('filtroSede');
        const filtroFecha = document.getElementById('filtroFecha');
        const btnLimpiarFiltros = document.getElementById('btnLimpiarFiltros');
        const contenedorEventos = document.getElementById('contenedorEventos');

        function aplicarFiltros() {
            const texto = (filtroNombre.value || '').trim().toLowerCase();
            const sede = filtroSede.value;
            const fecha = filtroFecha.value;

            const tarjetas = contenedorEventos.querySelectorAll('.evento-card');
            let visibles = 0;

            tarjetas.forEach(tarjeta => {
                const coincideNombre = texto === '' || (tarjeta.dataset.nombre || '').includes(texto);
                const coincideSede = sede === '' || tarjeta.dataset.sede === sede.toLowerCase();
                const coincideFecha = fecha === '' || tarjeta.dataset.fecha === fecha;

                const mostrar = coincideNombre && coincideSede && coincideFecha;
                tarjeta.closest('.col').classList.toggle('d-none', !mostrar);

                if (mostrar) {
                    visibles++;
                }
            });

            document.getElementById('sinResultados').classList.toggle('d-none', visibles > 0);
        }

        filtroNombre.addEventListener('input', aplicarFiltros);
        filtroSede.addEventListener('change', aplicarFiltros);
        filtroFecha.addEventListener('change', aplicarFiltros);

        btnLimpiarFiltros.addEventListener('click', function () {
            filtroNombre.value = '';
            filtroSede.value = '';
            filtroFecha.value = '';
            aplicarFiltros();
        });
    });
</script>

<style>
    .hero-section {
        position: relative;
        overflow: hidden;
        background: var(--gradient-hero);
        border: 1px solid rgba(13, 110, 253, 0.08);
        animation: aparecer 0.6s ease both;
    }

    .hero-imagen {
        height: clamp(300px, 40vw, 480px);
        object-fit: cover;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(13, 110, 253, 0.2) 0%, rgba(0, 0, 0, 0.55) 100%);
    }

    .hero-badge {
        background: var(--accent-soft-10);
        color: var(--accent);
    }

    .hero-subtitulo {
        max-width: 560px;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
    }

    .hero-section .carousel-caption {
        right: 5%;
        left: 5%;
        bottom: auto;
        top: 50%;
        transform: translateY(-50%);
        padding: 1rem;
        color: #fff;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
    }

    .hero-section .carousel-indicators {
        margin-bottom: 1rem;
    }

    .hero-section .carousel-indicators [data-bs-target] {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--accent);
        border: 1px solid rgba(255, 255, 255, 0.6);
    }

    .hero-section .carousel-control-prev-icon,
    .hero-section .carousel-control-next-icon {
        filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5));
    }

    .hero-section .evento-btn {
        background: rgba(13, 110, 253, 0.85);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.35);
        -webkit-backdrop-filter: blur(4px);
        backdrop-filter: blur(4px);
    }

    .hero-section .evento-btn:hover {
        background: var(--accent);
        color: #fff;
    }

    .evento-card {
        animation: aparecer 0.6s ease both;
    }

    .evento-btn {
        border-radius: var(--radius-pill);
        padding: 0.6rem 1.25rem;
        font-weight: 600;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 0.25rem 0.5rem var(--accent-soft-15);
    }

    .evento-btn:hover {
        transform: translateY(var(--lift-btn));
        box-shadow: 0 0.5rem 1rem var(--accent-soft-25);
    }

    @@keyframes aparecer {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .hero-section,
        .evento-card {
            animation: none;
        }

        .evento-btn:hover {
            transform: none;
        }

        .evento-btn {
            transition: none;
        }
    }
</style>

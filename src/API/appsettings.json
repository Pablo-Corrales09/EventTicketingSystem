{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "TicketAppAPI",
    "Audience": "TicketAppClient",
    "ExpireDays": 1
  },
  "RateLimits": {
    "CompraPorUsuario": {
      "PermitLimit": 5,
      "WindowSegundos": 60
    }
  }
}
